# Copiar a .env.local y ajustar. .env.local está en .gitignore.

# Backend real (profesor-scheduling-api). Sin slash final. Vacío = rutas relativas
# (necesario para que MSW las intercepte).
VITE_API_BASE_URL=http://localhost:3000

# 'true' (default) usa MSW en dev. 'false' habla directo con VITE_API_BASE_URL.
VITE_USE_MSW=true
